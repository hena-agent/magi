{
  "name": "@magi/tui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "magi": "./dist/index.js"
  },
  "scripts": {
    "build": "pnpm --filter @magi/core build && tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch --preserveWatchOutput",
    "start": "pnpm --filter @magi/core build && node dist/index.js",
    "start:tsx": "pnpm --filter @magi/core build && tsx src/index.tsx",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@magi/config": "workspace:*",
    "@magi/core": "workspace:*",
    "@magi/harness": "workspace:*",
    "ink": "^6.5.1",
    "react": "^19.2.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.7"
  }
}
